---
import Layout from "../layouts/Layout.astro";

const U = "https://images.unsplash.com/";
const q = "?auto=format&fit=crop&q=80";
const img = {
  hero:   U + "photo-1414235077428-338989a2e8c0" + q + "&w=1200",
  onas1:  U + "photo-1577219491135-ce391730fb2c" + q + "&w=800",
  onas2:  U + "photo-1555939594-58d7cb561a8b" + q + "&w=700",
  of1:    U + "photo-1555939594-58d7cb561a8b" + q + "&w=700",
  of2:    U + "photo-1467003909585-2f8a72700288" + q + "&w=700",
  of3:    U + "photo-1519671282429-b44b8c2cad81" + q + "&w=700",
  of4:    U + "photo-1546069901-ba9599a7e63c" + q + "&w=700",
  menu1:  U + "photo-1504674900247-0877df9cc836" + q + "&w=700",
  menu2:  U + "photo-1414235077428-338989a2e8c0" + q + "&w=700",
  menu3:  U + "photo-1476224203421-9ac39bcb3327" + q + "&w=700",
};

const oferta = [
  {
    nr: "01",
    name: "Catering firmowy",
    desc: "Codzienne lunche i przerwy kawowe dla biur. Zdrowe, smaczne posiłki — od poniedziałku do piątku, dostarczane punktualnie.",
    price: "od 28 zł/os.",
    tag: "Codziennie",
    img: img.of1,
  },
  {
    nr: "02",
    name: "Eventy i konferencje",
    desc: "Bufety, przerwy kawowe, kolacje galowe. Obsługujemy 20–2000 uczestników — kompleksowo, z pełną obsługą sali.",
    price: "od 65 zł/os.",
    tag: "Do 2000 os.",
    img: img.of2,
  },
  {
    nr: "03",
    name: "Wesela i przyjęcia",
    desc: "Menu weselne, tort od naszego cukiernika, obsługa kelnerska i dekoracja stołów. Twój wielki dzień w najlepszych rękach.",
    price: "od 180 zł/os.",
    tag: "Niezapomniane",
    img: img.of3,
  },
  {
    nr: "04",
    name: "Pudełka lunchowe",
    desc: "Diety abonamentowe i jednorazowe. Zbilansowane, sycące — dostarczamy każdego ranka prosto pod drzwi.",
    price: "od 35 zł/dzień",
    tag: "Każdy dzień",
    img: img.of4,
  },
];

const przystawki = [
  ["Tatar z łososia z awokado", "22 zł"],
  ["Bruschetta z pomidorami i bazylią", "15 zł"],
  ["Zupa krem z dyni z prażonymi pestkami", "18 zł"],
  ["Deska serów i wędlin regionalnych", "38 zł"],
  ["Sałatka z kozim serem i orzechami", "24 zł"],
  ["Carpaccio z buraków z ricottą", "20 zł"],
];
const dania = [
  ["Polędwiczki wieprzowe w sosie grzybowym", "48 zł"],
  ["Pierś z kurczaka faszerowana szpinakiem", "42 zł"],
  ["Łosoś pieczony z cytryną i koperkiem", "55 zł"],
  ["Risotto z grzybami leśnymi (vege)", "38 zł"],
  ["Kaczka w pomarańczach z krokietami", "62 zł"],
  ["Pierogi ruskie (porcja 10 szt.)", "28 zł"],
];
const desery = [
  ["Tiramisu klasyczne", "16 zł"],
  ["Tort weselny (za kg)", "180 zł"],
  ["Mini desery na tacy (10 szt.)", "55 zł"],
  ["Sernik na zimno z owocami", "14 zł"],
];
const pakiety = [
  ["Pakiet Biznes — 3 dania", "89 zł/os."],
  ["Pakiet Premium — 5 dań", "145 zł/os."],
  ["Pakiet Weselny — 7 dań", "220 zł/os."],
];

const opinie = [
  {
    name: "Katarzyna Wiśniewska",
    role: "HR Manager, TechPol S.A.",
    text: "Smaczna Uczta obsługuje nasze firmowe lunche od 2 lat. Jakość niezmiennie doskonała, dostawy zawsze na czas. Pracownicy są zachwyceni!",
    stars: 5,
  },
  {
    name: "Piotr i Marzena Jabłońscy",
    role: "Para młoda, wesele 2024",
    text: "Wesele marzeń! Menu weselne było hitem — goście do dziś wspominają kaczkę w pomarańczach i tort czekoladowy. Dziękujemy z całego serca.",
    stars: 5,
  },
  {
    name: "Tomasz Malinowski",
    role: "Dyrektor, IT Summit",
    text: "Obsługiwali catering dla 450 uczestników naszej konferencji. Logistyka bezbłędna, jedzenie świeże i smaczne, ekipa w pełni profesjonalna.",
    stars: 5,
  },
  {
    name: "Agnieszka Kowalik",
    role: "Klientka diety pudełkowej",
    text: "Zamawiam pudełka od 6 miesięcy. Porcje sycące, naprawdę smaczne i zróżnicowane. Schudłam 8 kg bez uczucia głodu — polecam każdemu!",
    stars: 5,
  },
];
---

<Layout
  title="Smaczna Uczta – Catering na każdą okazję"
  description="Smaczna Uczta – profesjonalny catering dla firm, wesel i eventów. Świeże składniki, domowy smak. Zapytaj o wycenę!"
>

  <!-- ===== NAV ===== -->
  <nav id="nav" class="fixed inset-x-0 z-40 bg-[#faf7f0]">
    <div class="mx-auto flex max-w-[1360px] items-center justify-between px-6 py-4 lg:px-10">

      <!-- Logo / brand -->
      <a href="#top" class="serif text-xl tracking-tight text-[#2b211f]">
        Smaczna&nbsp;<em>Uczta</em>
      </a>

      <!-- Desktop nav -->
      <div class="hidden items-center gap-8 md:flex">
        {(["O nas", "Oferta", "Menu", "Opinie", "Kontakt"] as const).map((l, i) => (
          <a
            href={`#${["o-nas","oferta","menu","opinie","kontakt"][i]}`}
            class="mono text-[0.68rem] uppercase tracking-widest text-[#7a6a60] transition-colors hover:text-[#241c1a]"
          >{l}</a>
        ))}
        <a
          href="#formularz"
          class="mono bg-[#d8462f] px-5 py-2.5 text-[0.68rem] uppercase tracking-widest text-[#faf7f0] transition-opacity hover:opacity-80"
        >Zamów wycenę</a>
      </div>

      <!-- Mobile burger -->
      <button id="burger" aria-label="Menu" class="flex flex-col gap-1.5 md:hidden">
        <span class="block h-px w-6 bg-[#2b211f]"></span>
        <span class="block h-px w-6 bg-[#2b211f]"></span>
        <span class="block h-px w-4 bg-[#2b211f]"></span>
      </button>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden border-t border-[#d9cfc0] bg-[#faf7f0] px-6 py-6 md:hidden">
      <div class="mono flex flex-col gap-5 text-sm uppercase tracking-widest text-[#7a6a60]">
        <a href="#o-nas">O nas</a>
        <a href="#oferta">Oferta</a>
        <a href="#menu">Menu</a>
        <a href="#opinie">Opinie</a>
        <a href="#kontakt">Kontakt</a>
        <a href="#formularz" class="inline-block bg-[#d8462f] px-5 py-3 text-center text-[#faf7f0]">Zamów wycenę</a>
      </div>
    </div>
  </nav>


  <!-- ===== HERO ===== -->
  <header id="top" class="relative overflow-hidden bg-[#faf7f0] pt-28 lg:pt-36">
    <div class="mx-auto max-w-[1360px] px-6 lg:px-10">

      <!-- Kicker -->
      <div class="flex items-center gap-4 pb-6">
        <span class="section-num">— Catering z pasją od 2012</span>
        <span class="flex-1 rule-line max-w-[120px]"></span>
        <span class="mono text-[0.6rem] uppercase tracking-widest text-[#7a6a60]">Warszawa i Mazowsze</span>
      </div>

      <!-- Ogromny nagłówek + foto — układ asymetryczny -->
      <div class="grid items-end gap-0 lg:grid-cols-[1.1fr_0.9fr]">

        <!-- Typografia -->
        <div class="pb-10 lg:pb-16">
          <h1 class="hero-word">
            <span class="block">Smaczna</span>
            <span class="block text-[#d8462f] italic">Uczta.</span>
          </h1>
          <p class="mt-8 max-w-md text-[1.05rem] leading-relaxed text-[#7a6a60]">
            Profesjonalny catering dla firm, wesel i eventów.
            Gotujemy ze świeżych, lokalnych składników —
            bo jedzenie powinno sprawiać prawdziwą radość.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a href="#formularz" class="bg-[#2b211f] px-8 py-4 font-medium text-[#faf7f0] transition-opacity hover:opacity-80">
              Zapytaj o wycenę
            </a>
            <a href="#oferta" class="mono border border-[#d9cfc0] px-6 py-4 text-[0.72rem] uppercase tracking-widest text-[#7a6a60] transition-colors hover:border-[#2b211f] hover:text-[#241c1a]">
              Pełna oferta →
            </a>
          </div>
          <!-- Statystyki inline -->
          <div class="mt-12 flex flex-wrap gap-10 border-t border-[#d9cfc0] pt-8">
            {[["12+", "lat doświadczenia"], ["2400+", "zrealizowanych eventów"], ["98%", "zadowolonych klientów"]].map(([n, l]) => (
              <div>
                <p class="serif text-3xl text-[#2b211f]">{n}</p>
                <p class="mono mt-1 text-[0.65rem] uppercase tracking-wider text-[#7a6a60]">{l}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Zdjęcie — wysunięte, wychodzi poza grid -->
        <div class="relative flex justify-end">
          <!-- dekoracyjna oliwkowa blokada -->
          <div class="absolute bottom-0 right-0 hidden h-4/5 w-3/4 bg-[#6b7a3a]/10 lg:block" style="transform: translate(2rem, 2rem);"></div>
          <div class="photo-frame relative overflow-hidden lg:-mb-px" style="max-width: 520px; width: 100%;">
            <img
              src={img.hero}
              alt="Elegancki stół cateringowy Smaczna Uczta"
              class="aspect-[3/4] w-full object-cover"
            />
            <!-- badge nad zdjęciem -->
            <div class="absolute bottom-6 left-6 bg-[#faf7f0] px-4 py-3" style="border: 1px solid #d9cfc0;">
              <p class="mono text-[0.6rem] uppercase tracking-widest text-[#7a6a60]">Ocena klientów</p>
              <p class="serif text-2xl text-[#2b211f]">4,9 <span class="text-[#d8462f]">★</span></p>
              <p class="mono text-[0.6rem] tracking-wider text-[#7a6a60]">380+ opinii Google</p>
            </div>
          </div>
        </div>

      </div>
    </div>
    <!-- Full-width kreska -->
    <div class="mt-0 border-t border-[#d9cfc0]"></div>
  </header>


  <!-- ===== O NAS ===== -->
  <section id="o-nas" class="px-6 py-20 lg:px-10 lg:py-28">
    <div class="mx-auto max-w-[1360px]">

      <!-- Nagłówek sekcji -->
      <div class="mb-14 flex items-center gap-6">
        <span class="section-num">01 / O nas</span>
        <span class="rule-line max-w-[200px]"></span>
      </div>

      <div class="grid items-start gap-16 lg:grid-cols-[1.2fr_1fr]">

        <!-- Kolaż zdjęć: nachodzące, eleganckie -->
        <div class="reveal relative" style="min-height: 520px;">
          <!-- Duże zdjęcie -->
          <div class="photo-frame overflow-hidden" style="width: 76%; position: relative; z-index: 1;">
            <img src={img.onas1} alt="Szef kuchni Smaczna Uczta przy pracy" class="aspect-[4/3] w-full object-cover" />
          </div>
          <!-- Mniejsze zdjęcie nachodzące -->
          <div class="photo-frame absolute overflow-hidden" style="width: 54%; bottom: 0; right: 0; z-index: 2; border: 1px solid #d9cfc0;">
            <img src={img.onas2} alt="Apetyczne potrawy cateringowe" class="aspect-[4/3] w-full object-cover" />
          </div>
          <!-- Rok założenia — typograficzny akcent -->
          <div class="absolute hidden lg:block" style="left: -1.5rem; bottom: 3rem; z-index: 3;">
            <p class="serif text-[5rem] leading-none text-[#d9cfc0]">2012</p>
            <p class="mono text-[0.6rem] uppercase tracking-widest text-[#7a6a60]">rok założenia</p>
          </div>
        </div>

        <!-- Tekst -->
        <div class="reveal-right">
          <h2 class="serif text-[clamp(2.5rem,5vw,4rem)] leading-[1.05] text-[#2b211f]">
            Gotujemy<br /><em class="text-[#d8462f]">z miłości</em><br />do smaku.
          </h2>

          <p class="drop-cap mt-8 leading-relaxed text-[#7a6a60]">
            Smaczna Uczta narodziła się w 2012 roku z prostej idei: każdy
            zasługuje na jedzenie, które sprawia prawdziwą radość. Założycielka
            <strong class="text-[#241c1a]">Marta Kowalczyk</strong> połączyła domową tradycję
            kulinarną z profesjonalnym cateringiem, tworząc markę, która zmienia
            sposób myślenia o jedzeniu na eventach.
          </p>

          <p class="mt-5 leading-relaxed text-[#7a6a60]">
            Dziś tworzymy zespół 18 pasjonatów. Współpracujemy wyłącznie z lokalnymi dostawcami:
            świeże warzywa od mazowieckich rolników, sery z podwarszawskich mleczarni,
            mięso od sprawdzonych hodowców. Żadnych półproduktów — tylko prawdziwe gotowanie.
          </p>

          <!-- Wartości jako elegancka lista -->
          <ul class="mt-10 space-y-3 border-t border-[#d9cfc0] pt-8">
            {["Lokalne, sezonowe składniki", "Doświadczeni szefowie kuchni", "Eko opakowania i zero odpadów", "Punktualność i pełna obsługa"].map((v) => (
              <li class="flex items-center gap-3 text-[0.9rem] text-[#241c1a]">
                <span class="h-px w-5 bg-[#d8462f] flex-shrink-0"></span>
                {v}
              </li>
            ))}
          </ul>
        </div>

      </div>
    </div>
  </section>


  <!-- ===== OFERTA ===== -->
  <section id="oferta" class="bg-[#2b211f] px-6 py-20 lg:px-10 lg:py-28">
    <div class="mx-auto max-w-[1360px]">

      <!-- Nagłówek -->
      <div class="mb-14 flex items-center gap-6">
        <span class="section-num text-[#efe7d6]/50">02 / Oferta</span>
        <span class="flex-1 rule-line max-w-[200px]" style="background: rgba(239,231,214,0.2);"></span>
        <span class="serif text-[clamp(2.8rem,6vw,5rem)] leading-none text-[#faf7f0]">Co <em class="text-[#d8462f]">robimy.</em></span>
      </div>

      <!-- Grid ofert: asymetryczny, 2+2 z różnymi proporcjami -->
      <div class="grid gap-px bg-[#efe7d6]/10 sm:grid-cols-2">
        {oferta.map((o, i) => (
          <article class={`reveal group relative overflow-hidden bg-[#2b211f] p-8 lg:p-10 ${i === 1 ? "lg:mt-16" : ""} ${i === 3 ? "lg:-mt-8" : ""}`}>
            <!-- Zdjęcie w cienkiej ramce -->
            <div class="mb-6 overflow-hidden" style="border: 1px solid rgba(239,231,214,0.15);">
              <img
                src={o.img}
                alt={o.name}
                loading="lazy"
                class="aspect-[16/9] w-full object-cover transition duration-700 group-hover:scale-105"
              />
            </div>

            <div class="flex items-start justify-between">
              <span class="serif text-[4rem] leading-none text-[#efe7d6]/15">{o.nr}</span>
              <span class="mono mt-1 text-[0.62rem] uppercase tracking-widest text-[#d8462f]">{o.tag}</span>
            </div>

            <h3 class="serif mt-2 text-[1.8rem] leading-tight text-[#faf7f0]">{o.name}</h3>
            <p class="mt-3 leading-relaxed text-[#efe7d6]/70 text-[0.9rem]">{o.desc}</p>

            <div class="mt-6 flex items-center justify-between border-t border-[#efe7d6]/10 pt-5">
              <span class="serif text-xl text-[#6b7a3a]">{o.price}</span>
              <a href="#formularz" class="mono text-[0.68rem] uppercase tracking-widest text-[#efe7d6]/50 transition-colors hover:text-[#faf7f0]">
                Zapytaj →
              </a>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>


  <!-- ===== MENU DEGUSTACYJNE ===== -->
  <section id="menu" class="px-6 py-20 lg:px-10 lg:py-28">
    <div class="mx-auto max-w-[1360px]">

      <!-- Nagłówek -->
      <div class="mb-14 flex items-start gap-6">
        <div>
          <div class="mb-4 flex items-center gap-4">
            <span class="section-num">03 / Menu</span>
            <span class="rule-line max-w-[100px]"></span>
          </div>
          <h2 class="serif text-[clamp(2.8rem,6vw,5rem)] leading-[1.0] text-[#2b211f]">
            Smaki,<br />które <em class="text-[#d8462f]">pamiętasz.</em>
          </h2>
        </div>
        <!-- Zdjęcie w prawym rogu nagłówka — editorial touch -->
        <div class="reveal-right ml-auto hidden pt-2 lg:block" style="width: 240px; flex-shrink: 0;">
          <div class="photo-frame overflow-hidden">
            <img src={img.menu3} alt="Eleganckie potrawy" loading="lazy" class="aspect-[3/4] w-full object-cover" />
          </div>
          <p class="mono mt-2 text-[0.6rem] uppercase tracking-wider text-[#7a6a60]">Sezonowe składniki · autorskie przepisy</p>
        </div>
      </div>

      <!-- Zdjęcia menu -->
      <div class="reveal mb-14 flex flex-wrap items-end gap-4">
        <div class="photo-frame overflow-hidden" style="width: clamp(160px, 22vw, 260px);">
          <img src={img.menu1} alt="Świeże potrawy cateringowe" loading="lazy" class="aspect-[3/4] w-full object-cover" />
        </div>
        <div class="photo-frame overflow-hidden" style="width: clamp(200px, 30vw, 360px); margin-top: 2rem;">
          <img src={img.menu2} alt="Stół cateringowy Smaczna Uczta" loading="lazy" class="aspect-[16/10] w-full object-cover" />
        </div>
        <!-- Tekstowy blok jak pull-quote -->
        <div class="ml-auto hidden max-w-[220px] border-l-2 border-[#d8462f] pl-6 lg:block">
          <p class="serif text-[1.8rem] leading-tight text-[#2b211f]">
            „Jedzenie to miłość zamknięta w smaku."
          </p>
          <p class="mono mt-3 text-[0.62rem] uppercase tracking-wider text-[#7a6a60]">— Marta Kowalczyk, założycielka</p>
        </div>
      </div>

      <!-- Karty menu w stylu magazynowym -->
      <div class="grid gap-8 md:grid-cols-3">

        <!-- Przystawki -->
        <div class="reveal">
          <div class="mb-5 border-b border-[#d9cfc0] pb-3">
            <p class="mono text-[0.62rem] uppercase tracking-[0.2em] text-[#7a6a60]">Rozdział I</p>
            <h3 class="serif mt-1 text-2xl text-[#2b211f]">Przystawki</h3>
          </div>
          <ul class="space-y-3">
            {przystawki.map(([n, p]) => (
              <li class="flex items-end text-[0.88rem]">
                <span class="text-[#241c1a]">{n}</span>
                <span class="dot-leader"></span>
                <span class="mono flex-shrink-0 text-[#d8462f]">{p}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Dania główne -->
        <div class="reveal" style="transition-delay: 0.1s;">
          <div class="mb-5 border-b border-[#d9cfc0] pb-3">
            <p class="mono text-[0.62rem] uppercase tracking-[0.2em] text-[#7a6a60]">Rozdział II</p>
            <h3 class="serif mt-1 text-2xl text-[#2b211f]">Dania główne</h3>
          </div>
          <ul class="space-y-3">
            {dania.map(([n, p]) => (
              <li class="flex items-end text-[0.88rem]">
                <span class="text-[#241c1a]">{n}</span>
                <span class="dot-leader"></span>
                <span class="mono flex-shrink-0 text-[#d8462f]">{p}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Desery + pakiety -->
        <div class="reveal space-y-8" style="transition-delay: 0.2s;">
          <div>
            <div class="mb-5 border-b border-[#d9cfc0] pb-3">
              <p class="mono text-[0.62rem] uppercase tracking-[0.2em] text-[#7a6a60]">Rozdział III</p>
              <h3 class="serif mt-1 text-2xl text-[#2b211f]">Desery</h3>
            </div>
            <ul class="space-y-3">
              {desery.map(([n, p]) => (
                <li class="flex items-end text-[0.88rem]">
                  <span class="text-[#241c1a]">{n}</span>
                  <span class="dot-leader"></span>
                  <span class="mono flex-shrink-0 text-[#d8462f]">{p}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Pakiety — elegancki akcent -->
          <div class="bg-[#2b211f] p-6">
            <p class="mono mb-4 text-[0.62rem] uppercase tracking-[0.2em] text-[#efe7d6]/50">Pakiety kompletne</p>
            <ul class="space-y-3">
              {pakiety.map(([n, p]) => (
                <li class="flex items-end text-[0.88rem]">
                  <span class="text-[#faf7f0]">{n}</span>
                  <span class="dot-leader" style="border-color: rgba(239,231,214,0.2);"></span>
                  <span class="mono flex-shrink-0 text-[#6b7a3a]">{p}</span>
                </li>
              ))}
            </ul>
            <a href="#formularz" class="mono mt-5 inline-block border-b border-[#d8462f] pb-0.5 text-[0.68rem] uppercase tracking-widest text-[#d8462f]">
              Indywidualna wycena →
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- ===== FORMULARZ ===== -->
  <section id="formularz" class="bg-[#efe7d6] px-6 py-20 lg:px-10 lg:py-28">
    <div class="mx-auto max-w-[1360px]">

      <div class="mb-4 flex items-center gap-4">
        <span class="section-num">04 / Zapytanie</span>
        <span class="rule-line max-w-[100px]"></span>
      </div>

      <div class="grid gap-16 lg:grid-cols-[1fr_1.4fr] items-start">

        <!-- Lewa: nagłówek + kontakt -->
        <div>
          <h2 class="serif text-[clamp(3rem,7vw,5.5rem)] leading-[1.0] text-[#2b211f]">
            Zapytaj<br />o <em class="text-[#d8462f]">ofertę.</em>
          </h2>
          <p class="mt-6 leading-relaxed text-[#7a6a60]">
            Odpiszemy w ciągu 24 godzin. Wycena zawsze gratis i bez żadnych zobowiązań.
          </p>

          <div class="mt-10 space-y-5 border-t border-[#d9cfc0] pt-8">
            {[
              ["Adres", "ul. Chmielna 15/3, 00-021 Warszawa"],
              ["Telefon", "+48 22 123 45 67 / +48 500 987 654"],
              ["E-mail", "kontakt@smaczna-uczta.pl"],
              ["Godziny", "Pon–Pt: 8:00–18:00 · Sob: 9:00–14:00"],
            ].map(([label, value]) => (
              <div class="flex gap-4">
                <span class="mono w-16 flex-shrink-0 text-[0.62rem] uppercase tracking-wider text-[#7a6a60]">{label}</span>
                <span class="text-[0.9rem] text-[#241c1a]">{value}</span>
              </div>
            ))}
          </div>

          <!-- Social linki -->
          <div class="mt-8 flex gap-5">
            {[["Facebook", "https://facebook.com"], ["Instagram", "https://instagram.com"], ["LinkedIn", "https://linkedin.com"]].map(([name, href]) => (
              <a href={href} target="_blank" rel="noopener noreferrer" class="mono text-[0.68rem] uppercase tracking-widest text-[#7a6a60] transition-colors hover:text-[#241c1a]">
                {name}
              </a>
            ))}
          </div>
        </div>

        <!-- Prawa: formularz -->
        <form class="reveal bg-[#faf7f0] p-8 lg:p-10" style="border: 1px solid #d9cfc0;" novalidate>
          <div class="grid gap-6 sm:grid-cols-2">
            <label class="block">
              <span class="mono mb-2 block text-[0.65rem] uppercase tracking-widest text-[#7a6a60]">Typ eventu *</span>
              <select required class="field">
                <option value="" disabled selected>Wybierz rodzaj...</option>
                <option>Catering firmowy</option>
                <option>Event / konferencja</option>
                <option>Wesele / przyjęcie</option>
                <option>Pudełka lunchowe</option>
                <option>Inne</option>
              </select>
            </label>
            <label class="block">
              <span class="mono mb-2 block text-[0.65rem] uppercase tracking-widest text-[#7a6a60]">Liczba osób *</span>
              <input type="number" min="1" placeholder="np. 50" required class="field" />
            </label>
            <label class="block">
              <span class="mono mb-2 block text-[0.65rem] uppercase tracking-widest text-[#7a6a60]">Planowany termin</span>
              <input type="date" class="field" />
            </label>
            <label class="block">
              <span class="mono mb-2 block text-[0.65rem] uppercase tracking-widest text-[#7a6a60]">Imię i nazwisko *</span>
              <input type="text" placeholder="Anna Nowak" required class="field" />
            </label>
            <label class="block sm:col-span-2">
              <span class="mono mb-2 block text-[0.65rem] uppercase tracking-widest text-[#7a6a60]">Adres e-mail *</span>
              <input type="email" placeholder="anna@firma.pl" required class="field" />
            </label>
            <label class="block">
              <span class="mono mb-2 block text-[0.65rem] uppercase tracking-widest text-[#7a6a60]">Telefon</span>
              <input type="tel" placeholder="+48 500 000 000" class="field" />
            </label>
            <label class="block sm:col-span-2">
              <span class="mono mb-2 block text-[0.65rem] uppercase tracking-widest text-[#7a6a60]">Wiadomość / szczegóły</span>
              <textarea rows="4" placeholder="Opisz szczegóły eventu, preferencje żywieniowe, budżet…" class="field resize-none"></textarea>
            </label>
          </div>

          <button
            type="submit"
            class="serif mt-6 w-full bg-[#2b211f] px-6 py-4 text-xl italic text-[#faf7f0] transition-opacity hover:opacity-80"
          >
            Wyślij zapytanie →
          </button>
          <p class="mono mt-4 text-center text-[0.6rem] uppercase tracking-wider text-[#7a6a60]">
            Dane służą wyłącznie do przygotowania wyceny · Smaczna Uczta sp. z o.o.
          </p>
        </form>

      </div>
    </div>
  </section>


  <!-- ===== OPINIE ===== -->
  <section id="opinie" class="px-6 py-20 lg:px-10 lg:py-28">
    <div class="mx-auto max-w-[1360px]">

      <div class="mb-14 flex items-center gap-6">
        <span class="section-num">05 / Opinie</span>
        <span class="rule-line max-w-[100px]"></span>
        <h2 class="serif text-[clamp(2rem,4.5vw,3.5rem)] leading-none text-[#2b211f]">
          Co mówią <em class="text-[#d8462f]">klienci.</em>
        </h2>
      </div>

      <!-- Grid opinii: 2 duże + 2 mniejsze, asymetria przez różne paddingi -->
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {opinie.map((op, i) => (
          <article
            class={`reveal bg-[#faf7f0] p-6 lg:p-8 ${i === 1 ? "lg:mt-10" : ""} ${i === 3 ? "lg:mt-6" : ""}`}
            style="border: 1px solid #d9cfc0;"
          >
            <!-- Cudzysłów dekoracyjny -->
            <p class="serif text-5xl leading-none text-[#d9cfc0]">"</p>
            <!-- Gwiazdki -->
            <div class="mb-4 flex gap-0.5">
              {Array.from({ length: op.stars }).map(() => (
                <span class="text-[#d8462f] text-sm">★</span>
              ))}
            </div>
            <p class="leading-relaxed text-[#241c1a] text-[0.9rem]">{op.text}</p>
            <div class="mt-6 border-t border-[#d9cfc0] pt-5">
              <p class="serif text-lg text-[#2b211f]">{op.name}</p>
              <p class="mono mt-1 text-[0.62rem] uppercase tracking-wider text-[#7a6a60]">{op.role}</p>
            </div>
          </article>
        ))}
      </div>

      <!-- Trust badges — prosta, elegancka linia -->
      <div class="reveal mt-16 flex flex-wrap items-center gap-10 border-t border-[#d9cfc0] pt-10">
        {[
          ["Catering Roku 2023", "Mazowsze Food Awards"],
          ["4,9 / 5 na Google", "ponad 380 opinii"],
          ["Zaufany Partner", "PKPP Lewiatan"],
        ].map(([title, sub]) => (
          <div>
            <p class="serif text-lg text-[#2b211f]">{title}</p>
            <p class="mono mt-1 text-[0.62rem] uppercase tracking-wider text-[#7a6a60]">{sub}</p>
          </div>
        ))}
      </div>

    </div>
  </section>


  <!-- ===== KONTAKT ===== -->
  <section id="kontakt" class="bg-[#2b211f] px-6 py-20 lg:px-10 lg:py-28">
    <div class="mx-auto max-w-[1360px]">

      <div class="mb-14 flex items-center gap-6">
        <span class="section-num text-[#efe7d6]/40">06 / Kontakt</span>
        <span class="flex-1 rule-line max-w-[100px]" style="background: rgba(239,231,214,0.2);"></span>
        <h2 class="serif text-[clamp(2rem,4.5vw,3.5rem)] leading-none text-[#faf7f0]">
          Jesteśmy <em class="text-[#6b7a3a]">blisko.</em>
        </h2>
      </div>

      <div class="grid gap-12 lg:grid-cols-2 items-start">

        <!-- Info kontaktowe -->
        <div class="reveal">
          <div class="grid grid-cols-2 gap-6 mb-10">
            {[
              { label: "Adres", lines: ["ul. Chmielna 15/3", "00-021 Warszawa"] },
              { label: "Telefon", lines: ["+48 22 123 45 67", "+48 500 987 654"] },
              { label: "E-mail", lines: ["kontakt@smaczna-uczta.pl", "wycena@smaczna-uczta.pl"] },
              { label: "Godziny pracy", lines: ["Pon–Pt: 8:00–18:00", "Sob: 9:00–14:00"] },
            ].map(({ label, lines }) => (
              <div style="border-top: 1px solid rgba(239,231,214,0.15);" class="pt-4">
                <p class="mono mb-2 text-[0.6rem] uppercase tracking-[0.2em] text-[#efe7d6]/40">{label}</p>
                {lines.map((line) => (
                  <p class="serif text-[1.05rem] text-[#faf7f0]">{line}</p>
                ))}
              </div>
            ))}
          </div>

          <!-- Social -->
          <div class="flex gap-6">
            {[["Facebook", "https://facebook.com"], ["Instagram", "https://instagram.com"], ["LinkedIn", "https://linkedin.com"]].map(([name, href]) => (
              <a href={href} target="_blank" rel="noopener noreferrer" class="mono text-[0.68rem] uppercase tracking-widest text-[#efe7d6]/50 transition-colors hover:text-[#faf7f0]">
                {name}
              </a>
            ))}
          </div>
        </div>

        <!-- Mapa OSM -->
        <div class="reveal-right overflow-hidden" style="border: 1px solid rgba(239,231,214,0.15); height: 380px;">
          <iframe
            src="https://www.openstreetmap.org/export/embed.html?bbox=20.993%2C52.228%2C21.025%2C52.248&layer=mapnik&marker=52.2381%2C21.009"
            width="100%"
            height="100%"
            style="border: 0; filter: grayscale(0.3);"
            allowfullscreen
            loading="lazy"
            title="Mapa — Smaczna Uczta, ul. Chmielna 15/3, Warszawa"
          ></iframe>
        </div>

      </div>
    </div>
  </section>


  <!-- ===== FOOTER ===== -->
  <footer class="border-t border-[#d9cfc0] bg-[#faf7f0] px-6 py-12 lg:px-10">
    <div class="mx-auto max-w-[1360px]">
      <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
        <div>
          <p class="serif text-2xl text-[#2b211f]">Smaczna <em>Uczta</em></p>
          <p class="mono mt-1 text-[0.62rem] uppercase tracking-wider text-[#7a6a60]">Catering · Warszawa i Mazowsze</p>
        </div>
        <div class="mono flex flex-wrap gap-6 text-[0.68rem] uppercase tracking-widest text-[#7a6a60]">
          {["#o-nas", "#oferta", "#menu", "#opinie", "#kontakt"].map((href, i) => (
            <a href={href} class="transition-colors hover:text-[#241c1a]">
              {["O nas","Oferta","Menu","Opinie","Kontakt"][i]}
            </a>
          ))}
        </div>
      </div>

      <div class="mono mt-10 flex flex-col gap-2 border-t border-[#d9cfc0] pt-6 text-center text-[0.65rem] uppercase tracking-wider text-[#7a6a60] sm:flex-row sm:justify-between">
        <span>© {new Date().getFullYear()} Smaczna Uczta sp. z o.o. Wszelkie prawa zastrzeżone.</span>
        <span>
          Przykładowa strona zrobiona przez&nbsp;<a
            href="https://100strona.pl"
            target="_blank"
            rel="noopener"
            class="text-[#2b211f] underline underline-offset-2 hover:text-[#d8462f] transition-colors"
          >3P sp. z o.o.</a>
        </span>
      </div>
    </div>
  </footer>

  <style>
    /* Nav scrolled */
    #nav.scrolled {
      background: color-mix(in srgb, var(--color-papier) 92%, transparent);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--color-border);
    }

    /* Form elements */
    .field {
      display: block;
      width: 100%;
      background: #faf7f0;
      border: 1px solid #d9cfc0;
      padding: 0.75rem 1rem;
      font-family: "DM Sans", system-ui, sans-serif;
      font-size: 0.9rem;
      color: #241c1a;
      outline: none;
      transition: border-color .2s, box-shadow .2s;
      -webkit-appearance: none;
      appearance: none;
    }
    .field:focus {
      border-color: #d8462f;
      box-shadow: 0 0 0 3px rgba(216, 70, 47, 0.12);
    }
  </style>

</Layout>
