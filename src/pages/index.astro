  <!-- ========== STYLES ========== -->
  <style>
    /* Scrolled nav */
    #nav.scrolled {
      background: color-mix(in srgb, var(--color-biel) 90%, transparent) !important;
      backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--color-krem);
    }
    #nav.scrolled a {
      color: var(--color-ciemny) !important;
    }
    #nav.scrolled #burger {
      color: var(--color-ciemny) !important;
    }

    /* Mobile menu open state */
    #mobile-menu.menu-open {
      max-height: 500px !important;
    }

    /* Scroll line animation */
    @keyframes scrollLine {
      0% { transform: translateY(-100%); }
      100% { transform: translateY(200%); }
    }

    /* Form focus styles */
    select:focus,
    input:focus,
    textarea:focus {
      border-color: var(--color-koral) !important;
      box-shadow: 0 0 0 3px rgba(239, 107, 83, 0.15) !important;
    }

    /* Hover card underline accent on service cards */
    .group:hover h3 {
      color: var(--color-zielen);
      transition: color 0.2s;
    }
  </style>
