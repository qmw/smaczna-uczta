---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Smaczna Uczta – Catering na każdą okazję"
  description="Smaczna Uczta – profesjonalny catering dla firm, wesel i eventów. Świeże składniki, domowy smak, elegancka oprawa. Zapytaj o wycenę!"
>
  <!-- ========== NAV ========== -->
  <header
    id="nav"
    class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
    style="background: rgba(42,38,31,0.6);"
  >
    <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
      <!-- Logo -->
      <a href="#" class="flex items-center gap-2 group">
        <span
          class="text-2xl leading-none"
          style="font-family: var(--font-display); color: var(--color-biel);"
        >
          Smaczna
        </span>
        <span
          class="text-2xl leading-none italic"
          style="font-family: var(--font-display); color: var(--color-koral);"
        >
          Uczta
        </span>
      </a>

      <!-- Desktop links -->
      <nav class="hidden lg:flex items-center gap-8">
        {
          [
            ["O nas", "#o-nas"],
            ["Oferta", "#oferta"],
            ["Menu", "#menu"],
            ["Opinie", "#opinie"],
            ["Kontakt", "#kontakt"],
          ].map(([label, href]) => (
            <a
              href={href}
              class="text-sm font-medium transition-colors duration-200 hover:text-[--color-koral]"
              style="color: rgba(252,250,246,0.85); font-family: var(--font-body);"
            >
              {label}
            </a>
          ))
        }
      </nav>

      <!-- CTA + burger -->
      <div class="flex items-center gap-4">
        <a href="#formularz" class="hidden lg:inline-flex btn-primary text-sm py-2.5 px-5">
          Zapytaj o ofertę
        </a>
        <button
          id="burger"
          class="lg:hidden flex flex-col gap-1.5 p-2"
          aria-label="Menu"
          style="color: var(--color-biel);"
        >
          <svg id="burger-open" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="burger-close" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile menu -->
    <div
      id="mobile-menu"
      class="lg:hidden overflow-hidden transition-all duration-300"
      style="max-height: 0;"
    >
      <div
        class="px-6 pb-6 pt-2 flex flex-col gap-4"
        style="background: rgba(42,38,31,0.97);"
      >
        {
          [
            ["O nas", "#o-nas"],
            ["Oferta", "#oferta"],
            ["Menu", "#menu"],
            ["Opinie", "#opinie"],
            ["Kontakt", "#kontakt"],
          ].map(([label, href]) => (
            <a
              href={href}
              class="text-base font-medium py-1 border-b border-white/10 transition-colors hover:text-[--color-koral]"
              style="color: rgba(252,250,246,0.85); font-family: var(--font-body);"
            >
              {label}
            </a>
          ))
        }
        <a href="#formularz" class="btn-primary text-sm mt-2 justify-center">
          Zapytaj o ofertę
        </a>
      </div>
    </div>
  </header>

  <!-- ========== HERO ========== -->
  <section
    id="hero"
    class="relative min-h-screen flex items-center justify-center overflow-hidden"
    style="background: var(--color-ciemny);"
  >
    <!-- Background image -->
    <div class="absolute inset-0 z-0">
      <img
        src="https://images.unsplash.com/photo-1414235077428-338989a2e8c0?auto=format&fit=crop&w=1800&q=80"
        alt="Apetyczny stół z potrawami cateringowymi"
        class="w-full h-full object-cover"
        style="opacity: 0.55;"
      />
    </div>
    <!-- Gradient overlay -->
    <div
      class="absolute inset-0 z-0"
      style="background: linear-gradient(to bottom, rgba(42,38,31,0.45) 0%, rgba(42,38,31,0.2) 40%, rgba(42,38,31,0.7) 100%);"
    ></div>
    <!-- Decorative circle -->
    <div
      class="absolute -bottom-24 -right-24 w-96 h-96 rounded-full z-0"
      style="background: radial-gradient(circle, rgba(77,124,15,0.25) 0%, transparent 70%);"
    ></div>

    <!-- Hero content -->
    <div class="relative z-10 max-w-4xl mx-auto px-6 text-center">
      <div class="mb-4 reveal">
        <span
          class="inline-block text-sm font-semibold tracking-widest uppercase px-4 py-1.5 rounded-full mb-6"
          style="background: rgba(239,107,83,0.2); color: var(--color-koral); border: 1px solid rgba(239,107,83,0.4); font-family: var(--font-body);"
        >
          Catering z pasją od 2012 roku
        </span>
      </div>
      <h1
        class="text-5xl sm:text-6xl md:text-7xl leading-tight mb-6 reveal reveal-delay-1"
        style="font-family: var(--font-display); color: var(--color-biel);"
      >
        Jedzenie, które<br />
        <em style="color: var(--color-koral);">opowiada historię</em>
      </h1>
      <p
        class="text-lg sm:text-xl max-w-2xl mx-auto mb-10 reveal reveal-delay-2"
        style="color: rgba(252,250,246,0.85); font-family: var(--font-body); line-height: 1.8;"
      >
        Tworzymy wyjątkowe doświadczenia kulinarne dla firm, wesel i prywatnych wydarzeń.
        Świeże składniki, domowy smak, elegancka oprawa — na każdą okazję.
      </p>
      <div class="flex flex-wrap gap-4 justify-center reveal reveal-delay-3">
        <a href="#formularz" class="btn-primary text-base px-8 py-4">
          Zamów wycenę
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a href="#menu" class="btn-secondary text-base px-8 py-4" style="border-color: rgba(252,250,246,0.5); color: var(--color-biel);">
          Zobacz menu
        </a>
      </div>

      <!-- Stats bar -->
      <div
        class="mt-16 grid grid-cols-3 gap-4 max-w-lg mx-auto reveal reveal-delay-4"
      >
        {
          [
            ["12+", "lat doświadczenia"],
            ["2 400+", "obsłużonych eventów"],
            ["98%", "zadowolonych klientów"],
          ].map(([num, label]) => (
            <div class="text-center">
              <div
                class="text-3xl font-bold"
                style="font-family: var(--font-display); color: var(--color-koral);"
              >
                {num}
              </div>
              <div class="text-xs mt-0.5" style="color: rgba(252,250,246,0.7);">
                {label}
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Scroll cue -->
    <div
      class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-2"
      style="color: rgba(252,250,246,0.5);"
    >
      <span class="text-xs tracking-widest uppercase" style="font-family: var(--font-body);">Przewiń</span>
      <div class="w-px h-10 overflow-hidden" style="background: rgba(252,250,246,0.2);">
        <div
          class="w-full h-1/2"
          style="background: var(--color-koral); animation: scrollLine 1.8s ease-in-out infinite;"
        ></div>
      </div>
    </div>
  </section>

  <!-- ========== O NAS ========== -->
  <section id="o-nas" class="py-24 lg:py-32" style="background: var(--color-biel);">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <!-- Images collage -->
        <div class="relative h-[520px] reveal">
          <div
            class="absolute top-0 left-0 w-3/4 h-80 rounded-2xl overflow-hidden shadow-2xl"
          >
            <img
              src="https://images.unsplash.com/photo-1577219491135-ce391730fb2c?auto=format&fit=crop&w=800&q=80"
              alt="Nasz szef kuchni przy pracy"
              class="w-full h-full object-cover transition-transform duration-700 hover:scale-105"
            />
          </div>
          <div
            class="absolute bottom-0 right-0 w-3/5 h-64 rounded-2xl overflow-hidden shadow-2xl border-4"
            style="border-color: var(--color-biel);"
          >
            <img
              src="https://images.unsplash.com/photo-1555939594-58d7cb561a8b?auto=format&fit=crop&w=800&q=80"
              alt="Apetyczne potrawy cateringowe"
              class="w-full h-full object-cover transition-transform duration-700 hover:scale-105"
            />
          </div>
          <!-- Decorative accent -->
          <div
            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-24 h-24 rounded-full flex items-center justify-center text-3xl shadow-lg z-10"
            style="background: var(--color-krem); border: 3px solid var(--color-koral);"
          >
            🌿
          </div>
          <!-- Year badge -->
          <div
            class="absolute -left-4 bottom-16 rounded-2xl p-4 shadow-xl z-10"
            style="background: var(--color-zielen); color: #fff;"
          >
            <div class="text-3xl font-bold" style="font-family: var(--font-display);">2012</div>
            <div class="text-xs mt-0.5 opacity-80">rok założenia</div>
          </div>
        </div>

        <!-- Text -->
        <div class="reveal reveal-delay-2">
          <span
            class="inline-block text-sm font-semibold tracking-widest uppercase mb-4"
            style="color: var(--color-zielen); font-family: var(--font-body);"
          >
            Nasza historia
          </span>
          <h2
            class="text-4xl lg:text-5xl mb-6 leading-tight"
            style="font-family: var(--font-display); color: var(--color-ciemny);"
          >
            Gotujemy z miłości<br />
            <em style="color: var(--color-zielen);">do jedzenia i ludzi</em>
          </h2>
          <p
            class="text-base mb-4 leading-relaxed"
            style="color: #5a5348; font-family: var(--font-body);"
          >
            Smaczna Uczta narodziła się w 2012 roku z prostej idei: każdy zasługuje na jedzenie,
            które sprawia prawdziwą radość. Założycielka Marta Kowalczyk, z wykształcenia technolog
            żywności i z zamiłowania kucharz-amator, postanowiła połączyć domową tradycję kulinarną
            z profesjonalnym cateringiem.
          </p>
          <p
            class="text-base mb-6 leading-relaxed"
            style="color: #5a5348; font-family: var(--font-body);"
          >
            Dziś tworzymy zespół 18 pasjonatów — kucharzy, cukierników i koordynatorów eventów.
            Współpracujemy wyłącznie z lokalnymi dostawcami: świeże warzywa od mazowieckich
            rolników, sery z podwarszawskich mleczarni, mięso od sprawdzonych hodowców.
            Żadnych półproduktów, żadnych skrótów — tylko prawdziwe gotowanie.
          </p>

          <!-- Values list -->
          <div class="grid grid-cols-2 gap-3 mb-8">
            {
              [
                ["🌱", "Lokalne składniki"],
                ["👨‍🍳", "Doświadczeni szefowie"],
                ["♻️", "Ekologiczne opakowania"],
                ["⏱️", "Punktualność gwarantowana"],
              ].map(([icon, text]) => (
                <div class="flex items-center gap-2 text-sm font-medium" style="color: var(--color-ciemny);">
                  <span class="text-base">{icon}</span>
                  {text}
                </div>
              ))
            }
          </div>

          <a href="#formularz" class="btn-primary">
            Poznaj nas bliżej
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== OFERTA ========== -->
  <section id="oferta" class="py-24 lg:py-32" style="background: var(--color-krem);">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-16 reveal">
        <span
          class="inline-block text-sm font-semibold tracking-widest uppercase mb-4"
          style="color: var(--color-zielen); font-family: var(--font-body);"
        >
          Co oferujemy
        </span>
        <h2
          class="text-4xl lg:text-5xl mb-4"
          style="font-family: var(--font-display); color: var(--color-ciemny);"
        >
          Nasze usługi
        </h2>
        <p
          class="text-base max-w-xl mx-auto"
          style="color: #7a6e5e; font-family: var(--font-body);"
        >
          Od codziennych lunchów po spektakularne wesela — dopasowujemy się do każdej okazji i każdego budżetu.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {
          [
            {
              img: "1555939594-58d7cb561a8b",
              icon: "🏢",
              title: "Catering firmowy",
              desc: "Codzienne lunche, przerwy kawowe i spotkania biznesowe. Zdrowe, smaczne posiłki dostarczane punktualnie do biura — od poniedziałku do piątku.",
              cta: "od 28 zł/os.",
              delay: "1",
            },
            {
              img: "1467003909585-2f8a72700288",
              icon: "🎤",
              title: "Eventy & konferencje",
              desc: "Kompleksowa obsługa bufetów, przerw kawowych i kolacji galowych. Obsługujemy od 20 do 2000 uczestników.",
              cta: "od 65 zł/os.",
              delay: "2",
            },
            {
              img: "1519671282429-b44b8c2cad81",
              icon: "💍",
              title: "Wesela i przyjęcia",
              desc: "Niezapomniane menu weselne, tort zamówiony u naszego cukiernika, obsługa kelnerska i dekoracja stołów. Twój wielki dzień w najlepszych rękach.",
              cta: "od 180 zł/os.",
              delay: "3",
            },
            {
              img: "1546069901-ba9599a7e63c",
              icon: "🥗",
              title: "Pudełka lunchowe",
              desc: "Abonamentowe diety pudełkowe i jednorazowe zamówienia. Zbilansowane, smaczne i dostarczane każdego ranka pod drzwi.",
              cta: "od 35 zł/dzień",
              delay: "4",
            },
          ].map(({ img, icon, title, desc, cta, delay }) => (
            <div
              class={`group rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 hover:-translate-y-1 reveal reveal-delay-${delay}`}
              style="background: var(--color-biel);"
            >
              <div class="h-44 overflow-hidden relative">
                <img
                  src={`https://images.unsplash.com/photo-${img}?auto=format&fit=crop&w=600&q=80`}
                  alt={title}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
                <div
                  class="absolute top-3 left-3 w-10 h-10 rounded-full flex items-center justify-center text-lg shadow-md"
                  style="background: var(--color-biel);"
                >
                  {icon}
                </div>
              </div>
              <div class="p-5">
                <h3
                  class="text-xl mb-2"
                  style="font-family: var(--font-display); color: var(--color-ciemny);"
                >
                  {title}
                </h3>
                <p class="text-sm leading-relaxed mb-4" style="color: #7a6e5e;">
                  {desc}
                </p>
                <div
                  class="inline-block text-sm font-bold px-3 py-1 rounded-full"
                  style="background: var(--color-krem); color: var(--color-zielen);"
                >
                  {cta}
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ========== MENU ========== -->
  <section id="menu" class="py-24 lg:py-32" style="background: var(--color-biel);">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-16 reveal">
        <span
          class="inline-block text-sm font-semibold tracking-widest uppercase mb-4"
          style="color: var(--color-koral); font-family: var(--font-body);"
        >
          Smaki, które pamiętasz
        </span>
        <h2
          class="text-4xl lg:text-5xl mb-4"
          style="font-family: var(--font-display); color: var(--color-ciemny);"
        >
          Nasze menu
        </h2>
        <p
          class="text-base max-w-xl mx-auto"
          style="color: #7a6e5e; font-family: var(--font-body);"
        >
          Sezonowe składniki, autorskie przepisy i odrobina miłości — oto sekret naszych dań.
        </p>
      </div>

      <!-- Hero food image strip -->
      <div class="grid grid-cols-3 gap-3 mb-14 reveal">
        {
          [
            ["1504674900247-0877df9cc836", "Świeże potrawy"],
            ["1414235077428-338989a2e8c0", "Stół cateringowy"],
            ["1546069901-ba9599a7e63c", "Lunchboxy"],
          ].map(([id, alt]) => (
            <div class="h-36 sm:h-48 rounded-xl overflow-hidden">
              <img
                src={`https://images.unsplash.com/photo-${id}?auto=format&fit=crop&w=600&q=80`}
                alt={alt}
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
              />
            </div>
          ))
        }
      </div>

      <!-- Menu categories -->
      <div class="grid md:grid-cols-3 gap-8">
        <!-- Przystawki -->
        <div
          class="rounded-2xl p-6 reveal reveal-delay-1"
          style="background: var(--color-krem);"
        >
          <div class="flex items-center gap-3 mb-5">
            <span class="text-2xl">🥗</span>
            <h3
              class="text-2xl"
              style="font-family: var(--font-display); color: var(--color-ciemny);"
            >
              Przystawki
            </h3>
          </div>
          <ul class="space-y-3">
            {
              [
                ["Tatar z łososia z awokado", "22 zł"],
                ["Bruschetta z pomidorami i bazylią", "15 zł"],
                ["Zupa krem z dyni z prażonymi pestkami", "18 zł"],
                ["Deska serów i wędlin regionalnych", "38 zł"],
                ["Sałatka z kozim serem i orzechami", "24 zł"],
                ["Carpaccio z buraków z ricottą", "20 zł"],
              ].map(([name, price]) => (
                <li
                  class="flex justify-between items-center py-2 border-b text-sm"
                  style="border-color: rgba(243,233,216,0.6);"
                >
                  <span style="color: var(--color-ciemny);">{name}</span>
                  <span
                    class="font-semibold ml-3 whitespace-nowrap"
                    style="color: var(--color-zielen);"
                  >
                    {price}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Dania główne -->
        <div
          class="rounded-2xl p-6 reveal reveal-delay-2 relative overflow-hidden"
          style="background: var(--color-zielen);"
        >
          <div
            class="absolute -top-6 -right-6 w-24 h-24 rounded-full opacity-20"
            style="background: var(--color-biel);"
          ></div>
          <div class="flex items-center gap-3 mb-5">
            <span class="text-2xl">🍖</span>
            <h3 class="text-2xl" style="font-family: var(--font-display); color: #fff;">
              Dania główne
            </h3>
          </div>
          <ul class="space-y-3">
            {
              [
                ["Polędwiczki wieprzowe w sosie grzybowym", "48 zł"],
                ["Pierś z kurczaka faszerowana szpinakiem", "42 zł"],
                ["Łosoś pieczony z cytryną i koperkiem", "55 zł"],
                ["Risotto z grzybami leśnymi (vege)", "38 zł"],
                ["Kaczka w pomarańczach z krokietami", "62 zł"],
                ["Pierogi ruskie (porcja 10 szt.)", "28 zł"],
              ].map(([name, price]) => (
                <li
                  class="flex justify-between items-center py-2 border-b text-sm"
                  style="border-color: rgba(255,255,255,0.15);"
                >
                  <span style="color: rgba(255,255,255,0.9);">{name}</span>
                  <span class="font-semibold ml-3 whitespace-nowrap" style="color: var(--color-krem);">
                    {price}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Desery + pakiety -->
        <div class="space-y-6 reveal reveal-delay-3">
          <!-- Desery -->
          <div class="rounded-2xl p-6" style="background: var(--color-krem);">
            <div class="flex items-center gap-3 mb-4">
              <span class="text-2xl">🍰</span>
              <h3
                class="text-2xl"
                style="font-family: var(--font-display); color: var(--color-ciemny);"
              >
                Desery
              </h3>
            </div>
            <ul class="space-y-2">
              {
                [
                  ["Tiramisu klasyczne", "16 zł"],
                  ["Tort weselny (za kg)", "180 zł"],
                  ["Mini desery na tacy (10 szt.)", "55 zł"],
                  ["Sernik na zimno z owocami", "14 zł"],
                ].map(([name, price]) => (
                  <li class="flex justify-between text-sm py-1.5 border-b" style="border-color: rgba(243,233,216,0.6);">
                    <span style="color: var(--color-ciemny);">{name}</span>
                    <span class="font-semibold ml-3 whitespace-nowrap" style="color: var(--color-koral);">
                      {price}
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>

          <!-- Set packages -->
          <div
            class="rounded-2xl p-5"
            style="background: var(--color-koral); color: #fff;"
          >
            <h4
              class="text-xl mb-3"
              style="font-family: var(--font-display);"
            >
              Pakiety kompletne
            </h4>
            <ul class="space-y-2 text-sm">
              <li class="flex justify-between">
                <span class="opacity-90">Pakiet Biznes (3 dania)</span>
                <span class="font-bold">89 zł/os.</span>
              </li>
              <li class="flex justify-between">
                <span class="opacity-90">Pakiet Premium (5 dań)</span>
                <span class="font-bold">145 zł/os.</span>
              </li>
              <li class="flex justify-between">
